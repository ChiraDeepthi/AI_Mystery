NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room
CLIENT_ORIGIN=http://localhost:5173
MIN_SCENARIO_LENGTH=30
MAX_SCENARIO_LENGTH=3000
GENERATION_RATE_LIMIT=5
